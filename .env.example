# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API Integration & Authentication
# NEXT_PUBLIC_API_URL: Base URL for Django REST Framework backend (e.g., http://localhost:8000/api)
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# NEXT_PUBLIC_API_MODE: 'mock' for local simulation mode, 'real' for live backend integration
NEXT_PUBLIC_API_MODE="mock"

# Cloudinary Direct Upload Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_FOLDER="tocco/products"

# Server-side Cloudinary Signing (Optional: for signed upload flow)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
