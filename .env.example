# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API Integration & Authentication
# API_PROXY_TARGET: Django backend origin WITHOUT trailing /api (e.g. https://your-backend.up.railway.app).
# Server-side only (no NEXT_PUBLIC_ prefix). Used by app/api/[...path]/route.ts to proxy
# same-origin "/api/*" requests to the real backend, so auth cookies stay first-party in
# the browser (fixes checkout->login loops in Facebook/Instagram in-app browsers & Safari).
API_PROXY_TARGET="https://your-backend.up.railway.app"

# NEXT_PUBLIC_API_URL: Only set this to bypass the proxy and call the backend directly
# (e.g. local dev without running the proxy route). Leave UNSET in production so the
# app defaults to the same-origin "/api" proxy above.
# NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Cloudinary Direct Upload Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_FOLDER="tocco/products"

# Server-side Cloudinary Signing (Optional: for signed upload flow)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
